#!/usr/bin/env bash
set -euo pipefail

MY_LIBRARY="{{ immich_upload_location }}"
BACKUP_MOUNT="{{ immich_backup_mount_point }}"
LOG_FILE="${MY_LIBRARY}/backups/immich-backup.log"
export RESTIC_REPOSITORY="${BACKUP_MOUNT}/restic-repo"

mkdir -p "${MY_LIBRARY}/backups"
exec >> "${LOG_FILE}" 2>&1

log() {
	echo "$(date --iso-8601=seconds) immich-backup: $*"
}

trap 'log "Backup failed"' ERR

# Do not create a repository on the host disk if the NFS mount is unavailable.
log "Checking backup mount"
mountpoint -q "${BACKUP_MOUNT}"

# Always bring Immich back up, even if dumping or backing up fails.
trap 'docker start immich_server >/dev/null 2>&1 || true; log "Immich server started"' EXIT

log "Stopping Immich server"
docker stop immich_server

# Back up a logical database dump, not the live PostgreSQL data directory.
if docker exec immich_postgres pg_isready --username=postgres --dbname=immich; then
    log "Creating PostgreSQL database dump"
    docker exec immich_postgres \
        pg_dump --clean --if-exists --username=postgres --dbname=immich \
        | gzip > "${MY_LIBRARY}/backups/immich-database-$(date --utc +%Y%m%dT%H%M%SZ).sql.gz"
else
    log "PostgreSQL is not ready, skipping database dump"
    exit 1
fi

# Thumbnails and transcoded videos can be regenerated after a restore.
log "Backing up Immich files to Restic"
restic backup "${MY_LIBRARY}" \
	--exclude "${MY_LIBRARY}/thumbs/**" \
	--exclude "${MY_LIBRARY}/encoded-video/**" \
    --verbose \
    --tag immich-backup

log "Applying Restic retention policy"
restic forget \
    --keep-weekly 4 --keep-monthly 3 --keep-hourly 6 --prune --tag immich-backup
log "Backup completed successfully"