services:
  protonmail-bridge:
    image: dancwilliams/protonmail-bridge:v3.25.0@sha256:32c44aaa56c168ec796c72a59159c1db0f55b8ba920a20e00c0e4ee129845134
    networks:
      - protonmail-network
    restart: unless-stopped
    volumes:
      - protonmail:/root
    environment:
      - KEYRING_PASSPHRASE=${PROTONMAIL_KEYRING_PASSPHRASE}

volumes:
  protonmail:
    name: protonmail

networks:
  protonmail-network:
    name: protonmail-network
    driver: bridge
