// Discover Docker containers and attach useful labels to their log streams.
discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.local.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
  }

  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }
}

// Read Docker container logs and forward them to Loki.
loki.source.docker "local" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.local.targets
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.process.docker_logs.receiver]
}

loki.source.syslog "syslog_receiver" {
  listener {
    address = "0.0.0.0:9514"
    use_rfc5424_message = true
    protocol = "udp"
    labels = {
      source = "remote_syslog",
    }
    label_structured_data = true
  }
  relabel_rules = loki.relabel.syslog_relabel.rules
  forward_to = [loki.process.syslog_router.receiver]
}

loki.relabel "syslog_relabel" {
  forward_to = [loki.process.syslog_router.receiver]

  rule {
    action = "labelmap"
    regex  = "__syslog_(.+)"
  }
}


loki.process "syslog_router" {
  stage.match {
    selector = "{connection_ip_address = \"{{ synology_ip }}\"}"

    stage.static_labels {
      values= {
        service_name = "synology.nas2",
        container = "syslog",
      }
    }
  }
  stage.match {
    selector = "{connection_ip_address = \"{{ truenas_ip }}\"}"

    stage.static_labels {
      values= {
        service_name = "truenas.nas",
        container = "syslog",
      }
    }
  }

  forward_to = [loki.write.default.receiver]
  // Drop any unwanted logs if necessary.
}

loki.process "docker_logs" {
  forward_to = [loki.write.default.receiver]

  // Do not ingest Alloy's own logs, which could create a feedback loop.
  stage.drop {
    source     = "container_name"
    expression = "alloy"
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
