# full list of environment variables with descriptions can be found in the documentation:
# https://dawarich.app/docs/self-hosting/environment-variables/

services:
  dawarich_redis:
    image: redis:{{ dawarich_redis_version }}
    container_name: dawarich_redis
    command: >
      redis-server
      --save 900 1
      --save 300 10
      --appendonly no
    networks:
      - dawarich_network
    volumes:
      - dawarich_shared:/data
    restart: always
    healthcheck:
      test: [ "CMD", "redis-cli", "--raw", "incr", "ping" ]
      interval: 10s
      retries: 5
      start_period: 30s
      timeout: 10s

  dawarich_db:
    image: postgis/postgis:{{ dawarich_postgis_version }}
    shm_size: 1G
    container_name: dawarich_db
    env_file:
      - path: ./postgres-pass.env
        format: raw
    volumes:
      - dawarich_db_data:/var/lib/postgresql/data
      - dawarich_shared:/var/shared
    networks:
      - dawarich_network
    environment:
      POSTGRES_USER: ${POSTGRES_USER:?POSTGRES_USER is required}
      POSTGRES_DB: ${POSTGRES_DB:?POSTGRES_DB is required}
    restart: always
    healthcheck:
      test: [ "CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-dawarich_development}" ]
      interval: 10s
      retries: 5
      start_period: 30s
      timeout: 10s
    # command: postgres -c config_file=/etc/postgresql/postgresql.conf # Use custom config, uncomment if you want to use a custom config

  dawarich_app:
    image: freikin/dawarich:{{ dawarich_version }}
    container_name: dawarich_app
    volumes:
      - dawarich_public:/var/app/public
      - dawarich_watched:/var/app/tmp/imports/watched
      - dawarich_storage:/var/app/storage
      - dawarich_db_data:/dawarich_db_data
    networks:
      - dawarich_network
      - protonmail-network
      - monitoring-network
    ports:
      - "${DAWARICH_APP_PORT:-3000}:3000"
    stdin_open: true
    tty: true
    entrypoint: web-entrypoint.sh
    command: ['bin/rails', 'server', '-p', '3000', '-b', '::']
    restart: unless-stopped
    env_file:
      - path: ./database-pass.env
        format: raw
      - path: ./secret-key.env
        format: raw
      - path: ./smtp-pass.env
        format: raw
      - path: ./metrics-pass.env
        format: raw
    environment:
      RAILS_ENV: ${RAILS_ENV:?RAILS_ENV is required}
      ### To run under a non-root user, set PUID/PGID here (do NOT use `user:`).
      # PUID: ${PUID:-1000}
      # PGID: ${PGID:-1000}
      REDIS_URL: ${REDIS_URL:?REDIS_URL is required}
      DATABASE_HOST: ${DATABASE_HOST:?DATABASE_HOST is required}
      DATABASE_PORT: ${DATABASE_PORT:?DATABASE_PORT is required}
      DATABASE_USERNAME: ${DATABASE_USERNAME:?DATABASE_USERNAME is required}
      DATABASE_NAME: ${DATABASE_NAME:?DATABASE_NAME is required}
      APPLICATION_HOSTS: ${APPLICATION_HOSTS:?APPLICATION_HOSTS is required}
      TIME_ZONE: ${TIME_ZONE:?TIME_ZONE is required}
      APPLICATION_PROTOCOL: ${APPLICATION_PROTOCOL:?APPLICATION_PROTOCOL is required}
      PROMETHEUS_EXPORTER_ENABLED: ${PROMETHEUS_EXPORTER_ENABLED:?PROMETHEUS_EXPORTER_ENABLED is required}
      METRICS_USERNAME: ${METRICS_USERNAME:?METRICS_USERNAME environment variable is required}
      RAILS_LOG_TO_STDOUT: ${RAILS_LOG_TO_STDOUT:?RAILS_LOG_TO_STDOUT is required}
      SELF_HOSTED: ${SELF_HOSTED:?SELF_HOSTED is required}
      STORE_GEODATA: ${STORE_GEODATA:?STORE_GEODATA is required}
      # One preloaded Puma worker is plenty for a household instance and
      # halves idle memory. Raise for busier instances.
      WEB_CONCURRENCY: ${WEB_CONCURRENCY:?WEB_CONCURRENCY is required}
      ### OTP encryption keys are required if you want to use 2FA
      # OTP_ENCRYPTION_PRIMARY_KEY: ${OTP_ENCRYPTION_PRIMARY_KEY:-}
      # OTP_ENCRYPTION_DETERMINISTIC_KEY: ${OTP_ENCRYPTION_DETERMINISTIC_KEY:-}
      # OTP_ENCRYPTION_KEY_DERIVATION_SALT: ${OTP_ENCRYPTION_KEY_DERIVATION_SALT:-}
      DOMAIN: ${DOMAIN:?DOMAIN environment variable is required}
      SMTP_SERVER: ${SMTP_SERVER:?SMTP_SERVER is required}
      SMTP_PORT: ${SMTP_PORT:?SMTP_PORT is required}
      SMTP_DOMAIN: ${SMTP_DOMAIN:?SMTP_DOMAIN is required}
      SMTP_USERNAME: ${SMTP_USERNAME:?SMTP_USERNAME is required}
      SMTP_FROM: ${SMTP_FROM:?SMTP_FROM is required}
      SMTP_AUTHENTICATION: ${SMTP_AUTHENTICATION:?SMTP_AUTHENTICATION is required}
      SMTP_STARTTLS: ${SMTP_STARTTLS:?SMTP_STARTTLS is required}
      PHOTON_API_HOST: ${PHOTON_API_HOST:?PHOTON_API_HOST is required}
      PHOTON_API_USE_HTTPS: ${PHOTON_API_USE_HTTPS:?PHOTON_API_USE_HTTPS is required}
    logging:
      driver: "json-file"
      options:
        max-size: ${LOG_MAX_SIZE:-100m}
        max-file: ${LOG_MAX_FILE:-5}
    healthcheck:
      test: [ "CMD-SHELL", "wget -qO - http://127.0.0.1:3000/api/v1/health | grep -q '\"status\"\\s*:\\s*\"ok\"'" ]
      interval: 10s
      retries: 30
      start_period: 30s
      timeout: 10s
    depends_on:
      photon:
        condition: service_started
      dawarich_db:
        condition: service_healthy
        restart: true
      dawarich_redis:
        condition: service_healthy
        restart: true
    deploy:
      resources:
        limits:
          cpus: ${APP_CPU_LIMIT:-0.50}
          memory: ${APP_MEMORY_LIMIT:-4G}

  dawarich_sidekiq:
    image: freikin/dawarich:{{ dawarich_version }}
    container_name: dawarich_sidekiq
    expose:
      - 9394
    volumes:
      - dawarich_public:/var/app/public
      - dawarich_watched:/var/app/tmp/imports/watched
      - dawarich_storage:/var/app/storage
    networks:
      - dawarich_network
      - protonmail-network
    stdin_open: true
    tty: true
    entrypoint: sidekiq-entrypoint.sh
    command: ['sidekiq']
    restart: unless-stopped
    env_file:
      - path: ./database-pass.env
        format: raw
      - path: ./secret-key.env
        format: raw
      - path: ./smtp-pass.env
        format: raw
      - path: ./metrics-pass.env
        format: raw
    environment:
      RAILS_ENV: ${RAILS_ENV:?RAILS_ENV is required}
      ### To run under a non-root user, set PUID/PGID here (do NOT use `user:`).
      # PUID: ${PUID:-1000}
      # PGID: ${PGID:-1000}
      REDIS_URL: ${REDIS_URL:?REDIS_URL is required}
      DATABASE_HOST: ${DATABASE_HOST:?DATABASE_HOST is required}
      DATABASE_PORT: ${DATABASE_PORT:?DATABASE_PORT is required}
      DATABASE_USERNAME: ${DATABASE_USERNAME:?DATABASE_USERNAME is required}
      DATABASE_NAME: ${DATABASE_NAME:?DATABASE_NAME is required}
      APPLICATION_HOSTS: ${APPLICATION_HOSTS:-localhost,::1,127.0.0.1}
      # 3 job threads keep idle memory and DB connections low; raise
      # temporarily for large imports.
      BACKGROUND_PROCESSING_CONCURRENCY: ${BACKGROUND_PROCESSING_CONCURRENCY:?BACKGROUND_PROCESSING_CONCURRENCY is required}
      APPLICATION_PROTOCOL: ${APPLICATION_PROTOCOL:?APPLICATION_PROTOCOL is required}
      PROMETHEUS_EXPORTER_ENABLED: ${PROMETHEUS_EXPORTER_ENABLED:?PROMETHEUS_EXPORTER_ENABLED is required}
      METRICS_USERNAME: ${METRICS_USERNAME:?METRICS_USERNAME environment variable is required}
      RAILS_LOG_TO_STDOUT: ${RAILS_LOG_TO_STDOUT:?RAILS_LOG_TO_STDOUT is required}
      SELF_HOSTED: ${SELF_HOSTED:?SELF_HOSTED is required}
      STORE_GEODATA: ${STORE_GEODATA:-true}
      ### OTP encryption keys are required if you want to use 2FA
      # OTP_ENCRYPTION_PRIMARY_KEY: ${OTP_ENCRYPTION_PRIMARY_KEY:-}
      # OTP_ENCRYPTION_DETERMINISTIC_KEY: ${OTP_ENCRYPTION_DETERMINISTIC_KEY:-}
      # OTP_ENCRYPTION_KEY_DERIVATION_SALT: ${OTP_ENCRYPTION_KEY_DERIVATION_SALT:-}
      TIME_ZONE: ${TIME_ZONE:?TIME_ZONE is required}
      DOMAIN: ${DOMAIN:?DOMAIN environment variable is required}
      SMTP_SERVER: ${SMTP_SERVER:?SMTP_SERVER is required}
      SMTP_PORT: ${SMTP_PORT:?SMTP_PORT environment variable is required}
      SMTP_DOMAIN: ${SMTP_DOMAIN:?SMTP_DOMAIN environment variable is required}
      SMTP_USERNAME: ${SMTP_USERNAME:?SMTP_USERNAME environment variable is required}
      SMTP_FROM: ${SMTP_FROM:?SMTP_FROM environment variable is required}
      SMTP_AUTHENTICATION: ${SMTP_AUTHENTICATION:?SMTP_AUTHENTICATION is required}
      SMTP_STARTTLS: ${SMTP_STARTTLS:?SMTP_STARTTLS is required}
      PHOTON_API_HOST: ${PHOTON_API_HOST:?PHOTON_API_HOST is required}
      PHOTON_API_USE_HTTPS: ${PHOTON_API_USE_HTTPS:?PHOTON_API_USE_HTTPS is required}
    logging:
      driver: "json-file"
      options:
        max-size: ${LOG_MAX_SIZE:-100m}
        max-file: ${LOG_MAX_FILE:-5}
    healthcheck:
      test: [ "CMD-SHELL", "pgrep -f sidekiq" ]
      interval: 10s
      retries: 30
      start_period: 30s
      timeout: 10s
    depends_on:
      photon:
        condition: service_started
      dawarich_db:
        condition: service_healthy
        restart: true
      dawarich_redis:
        condition: service_healthy
        restart: true
      dawarich_app:
        condition: service_healthy
        restart: true

  photon:
      image: ghcr.io/rtuszik/photon-docker:latest@sha256:729f883612bde3215c156111b421d8e0a27b1eb411b92ef4a24bd587b8259b04
      container_name: photon-dawarich
      environment:
          - UPDATE_STRATEGY=${UPDATE_STRATEGY:?UPDATE_STRATEGY is required}
          - UPDATE_INTERVAL=${UPDATE_INTERVAL:?UPDATE_INTERVAL is required}
          - LOG_LEVEL=${LOG_LEVEL:?LOG_LEVEL is required} # Options: DEBUG, INFO, ERROR
          - ENABLE_METRICS=${ENABLE_METRICS:?ENABLE_METRICS is required}
      volumes:
          - photon_data:/photon/data
      restart: unless-stopped
      expose:
          - 2322
      networks:
          - dawarich_network
          - monitoring-network

volumes:
  dawarich_db_data:
    name: dawarich_dawarich_db_data
  dawarich_shared:
    name: dawarich_dawarich_shared
  dawarich_public:
    name: dawarich_dawarich_public
  dawarich_watched:
    name: dawarich_dawarich_watched
  dawarich_storage:
    name: dawarich_dawarich_storage
  photon_data:
    name: dawarich_photon_data

networks:
  dawarich_network:
    external: true
    name: dawarich_network

  protonmail-network:
    external: true
    name: protonmail-network

  monitoring-network:
    external: true
    name: monitoring-network
