services:
  geoipupdate:
    container_name: geoipupdate
    image: ghcr.io/maxmind/geoipupdate:{{ max_mind_geoipupdate_version }}
    restart: unless-stopped
    environment:
      - 'GEOIPUPDATE_ACCOUNT_ID={{ max_mind_account_id }}'							# Account ID
      - 'GEOIPUPDATE_LICENSE_KEY={{ max_mind_license_key }}'							# API key
      - 'GEOIPUPDATE_EDITION_IDS=GeoLite2-Country GeoLite2-ASN'	# Which dbs should be downloaded
      - GEOIPUPDATE_FREQUENCY=72						# Update intervall in hours
      - GEOIPUPDATE_VERBOSE=1
    volumes:
      - './config/GeoLite2:/usr/share/GeoIP'