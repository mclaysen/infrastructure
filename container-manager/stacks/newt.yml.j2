services:
  newt:
    env_file:
      - path: ./id.env
        format: raw
      - path: ./secret.env
        format: raw
    image: fosrl/newt:{{ newt_version }}
    container_name: newt
    restart: unless-stopped
    extra_hosts:
      - "host.docker.internal:host-gateway"
      - "pangolin.{{ domain }}:{{ vps_ip }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ blueprint_file_path }}:/app/config/home1_pangolin_blueprint.yml
    environment:
      - PANGOLIN_ENDPOINT=${PANGOLIN_ENDPOINT:?Pangolin endpoint is not set}
      - DOCKER_SOCKET=${DOCKER_SOCKET:?Docker socket is not set}
      - DNS=${DNS:?DNS is not set}
      - BLUEPRINT_FILE=${BLUEPRINT_FILE:?Blueprint file is not set}
    networks:
      - pangolin_network
networks:
  pangolin_network:
    external: true