global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: unpoller
    static_configs:
      - targets: ["unpoller:9130"]

  - job_name: photon
    static_configs:
      - targets: ["photon:2322"]

  - job_name: dawarich
    basic_auth:
      username: "{{ dawarich_metrics_username }}"
      password: "{{ dawarich_metrics_password }}"
    static_configs:
      - targets: ["dawarich_app:3000"]

  - job_name: node_exporter
    static_configs:
      - targets: ["host.docker.internal:9100"]

  - job_name: docker_daemon
    static_configs:
      - targets: ["host.docker.internal:9323"]

  - job_name: cadvisor
    static_configs:
      - targets: ["host.docker.internal:8080"]

  - job_name: jellyfin
    static_configs:
      - targets: ["host.docker.internal:8096"]

  - job_name: nginx
    static_configs:
      - targets: ["{{ nginx_prometheus_exporter_target }}"]

  - job_name: blackbox_http2xx
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
        - https://mclaysen.com
    relabel_configs:
    - source_labels: [__address__]
      target_label: __param_target
    - source_labels: [__param_target]
      target_label: instance
    - target_label: __address__
      replacement: blackbox:9115