#
# WARNING: To install Immich, follow our guide: https://docs.immich.app/install/docker-compose
#
# Make sure to use the docker-compose.yml of the current release:
#
# https://github.com/immich-app/immich/releases/latest/download/docker-compose.yml
#
# The compose file on main may not be compatible with the latest release.

services:
  immich-server:
    container_name: immich_server
    image: ghcr.io/immich-app/immich-server:{{ immich_server_version }}
    volumes:
      - "{{ immich_upload_location }}:/data"
{% if immich_external_photos_mount_point is defined and immich_external_photos_container_path is defined %}
      - {{ immich_external_photos_mount_point }}:{{ immich_external_photos_container_path }}:ro
{% endif %}
      - /etc/localtime:/etc/localtime:ro
    env_file:
      - path: ./database-pass.env
        format: raw
    environment:
      UPLOAD_LOCATION: ${UPLOAD_LOCATION:?UPLOAD_LOCATION is required}
      DB_DATA_LOCATION: ${DB_DATA_LOCATION:?DB_DATA_LOCATION is required}
      DB_USERNAME: ${DB_USERNAME:?DB_USERNAME is required}
      DB_DATABASE_NAME: ${DB_DATABASE_NAME:?DB_DATABASE_NAME is required}
    ports:
      - '2283:2283'
    depends_on:
      - redis
      - database
    restart: always
    healthcheck:
      disable: false
    networks:
      - immich-network
      - protonmail-network

  immich-machine-learning:
    container_name: immich_machine_learning
    # For hardware acceleration, add one of -[armnn, cuda, rocm, openvino, rknn] to the image tag.
    # Example tag: ${IMMICH_VERSION:-release}-cuda
    image: ghcr.io/immich-app/immich-machine-learning:{{ immich_machine_learning_version }}
    volumes:
      - model-cache:/cache
    env_file:
      - path: ./database-pass.env
        format: raw
    environment:
      UPLOAD_LOCATION: ${UPLOAD_LOCATION:?UPLOAD_LOCATION is required}
      DB_DATA_LOCATION: ${DB_DATA_LOCATION:?DB_DATA_LOCATION is required}
      DB_USERNAME: ${DB_USERNAME:?DB_USERNAME is required}
      DB_DATABASE_NAME: ${DB_DATABASE_NAME:?DB_DATABASE_NAME is required}
    restart: always
    healthcheck:
      disable: false
    networks:
      - immich-network

  redis:
    container_name: immich_redis
    image: docker.io/valkey/valkey:9@sha256:3b55fbaa0cd93cf0d9d961f405e4dfcc70efe325e2d84da207a0a8e6d8fde4f9
    healthcheck:
      test: redis-cli ping || exit 1
    restart: always
    networks:
      - immich-network

  database:
    container_name: immich_postgres
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
    env_file:
      - path: ./postgres-pass.env
        format: raw
    environment:
      POSTGRES_USER: ${DB_USERNAME:?DB_USERNAME is required}
      POSTGRES_DB: ${DB_DATABASE_NAME:?DB_DATABASE_NAME is required}
      POSTGRES_INITDB_ARGS: ${POSTGRES_INITDB_ARGS:?POSTGRES_INITDB_ARGS is required}
      DB_STORAGE_TYPE: ${DB_STORAGE_TYPE:?DB_STORAGE_TYPE is required}
    volumes:
      - "{{ immich_db_data_location }}:/var/lib/postgresql/data"
    shm_size: 128mb
    restart: always
    healthcheck:
      disable: false
    networks:
      - immich-network

volumes:
  model-cache:
    name: immich_model-cache
networks:
  immich-network:
    external: true
    name: immich_immich-network
  protonmail-network:
    external: true
    name: protonmail-network
