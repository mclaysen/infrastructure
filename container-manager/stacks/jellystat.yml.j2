services:
  jellystat:
    env_file:
      - path: ./db-secrets.env
        format: raw
      - path: ./jwt-token.env
        format: raw
    image: cyfershepard/jellystat:{{ jellystat_version }}
    container_name: jellystat
    restart: unless-stopped
    ports:
      - '3000:3000'
    environment:
      - POSTGRES_USER=${POSTGRES_USER:?Postgres user not set}
      - POSTGRES_IP=${POSTGRES_IP:?Postgres IP not set}
      - POSTGRES_PORT=${POSTGRES_PORT:?Postgres port not set}
      - TZ=${TZ:?Timezone not set}
    depends_on:
      - jellystat-db
    volumes:
      - 'jellystat-backup-data:/app/backend/backup-data'
    networks:
      - pangolin_network
  jellystat-db:
    image: 'postgres:15.2'
    shm_size: 256mb
    container_name: jellystat-db
    restart: unless-stopped
    env_file:
      - path: ./db-secrets.env
        format: raw
    environment:
      - POSTGRES_USER=${POSTGRES_USER:?Postgres user not set}
    volumes:
      - 'jellystat-db:/var/lib/postgresql/data'
    networks:
      - pangolin_network
networks:
  pangolin_network:
    external: true
volumes:
  jellystat-db:
    name: jellystat_jellystat-db
  jellystat-backup-data:
    name: jellystat_jellystat-backup-data
