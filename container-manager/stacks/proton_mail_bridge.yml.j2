services:
  protonmail-bridge:
    image: dancwilliams/protonmail-bridge:{{ protonmail_bridge_version }}
    networks:
      - protonmail-network
    restart: unless-stopped
    volumes:
      - protonmail:/root
    env_file:
      - path: ./secret.env
        format: raw

volumes:
  protonmail:
    name: protonmail

networks:
  protonmail-network:
    external: true
    name: protonmail-network
