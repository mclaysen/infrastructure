POSTGRES_USER=postgres
POSTGRES_DB=dawarich_development
RAILS_ENV=production
REDIS_URL=redis://dawarich_redis:6379
DATABASE_HOST=dawarich_db
DATABASE_PORT=5432
DATABASE_NAME=dawarich_development
DATABASE_USERNAME=postgres
DAWARICH_APP_PORT={{ dawarich_app_port }}
APPLICATION_HOSTS={{ dawarich_application_hosts }}
TIME_ZONE={{ timezone }}
PROMETHEUS_EXPORTER_ENABLED={{ dawarich_prometheus_exporter_enabled | string | lower }}
METRICS_USERNAME={{ dawarich_metrics_username }}
DOMAIN={{ dawarich_domain }}
RAILS_LOG_TO_STDOUT=true
SELF_HOSTED=true
STORE_GEODATA=true
WEB_CONCURRENCY=1
APPLICATION_PROTOCOL={{ dawarich_application_protocol | default('http') }}
SMTP_SERVER={{ email_domain }}
SMTP_PORT={{ email_port }}
SMTP_DOMAIN={{ domain }}
SMTP_USERNAME={{ email_user }}
SMTP_FROM={{ email_address }}
SMTP_AUTHENTICATION={{ dawarich_smtp_authentication | default('plain') }}
SMTP_STARTTLS={{ dawarich_smtp_starttls | default('true') }}
PHOTON_API_HOST=photon:2322
PHOTON_API_USE_HTTPS=false
BACKGROUND_PROCESSING_CONCURRENCY=3
UPDATE_STRATEGY=SEQUENTIAL
UPDATE_INTERVAL=30d
LOG_LEVEL=INFO
ENABLE_METRICS=true