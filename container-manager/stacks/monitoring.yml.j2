services:
  snmp_exporter:
    image: prom/snmp-exporter:{{ snmp_exporter_version }}
    container_name: snmp_exporter
    restart: unless-stopped
    expose:
      - "9116"
    volumes:
      - {{ snmp_exporter_config_path }}:/etc/snmp_exporter/snmp.yml:ro
    networks:
      - monitoring-network
  prometheus:
    container_name: prometheus
    image: prom/prometheus:{{ prometheus_version }}
    restart: unless-stopped
    ports:
      - {{ prometheus_host_port }}:9090
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - {{ prometheus_config_path }}:/etc/prometheus/prometheus.yml
      - prometheus_data:/prometheus
    networks:
      - monitoring-network
  grafana:
    image: grafana/grafana-enterprise:12.3.1
    container_name: grafana
    restart: unless-stopped
    environment:
      - GF_SERVER_ROOT_URL=${GF_SERVER_ROOT_URL}
      - GF_PLUGINS_PREINSTALL=${GF_PLUGINS_PREINSTALL}
    ports:
      - '3001:3000'
    volumes:
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
      - 'grafana_storage:/var/lib/grafana'
      - {{ grafana_provisioning_path }}:/etc/grafana/provisioning:ro
      - {{ grafana_dashboards_path }}:/var/lib/grafana/dashboards:ro
    networks:
      - monitoring-network
    depends_on:
      - prometheus
  unpoller:
    image: ghcr.io/unpoller/unpoller:v2.33.0
    restart: unless-stopped
    ports:
      - '9130:9130'
    container_name: unpoller
    env_file:
      - path: ./unfi-pass.env
        format: raw
    environment:
      - UP_INFLUXDB_DISABLE=${UP_INFLUXDB_DISABLE}
      - UP_POLLER_DEBUG=${UP_POLLER_DEBUG}
      - UP_UNIFI_DYNAMIC=${UP_UNIFI_DYNAMIC}
      - UP_PROMETHEUS_HTTP_LISTEN=${UP_PROMETHEUS_HTTP_LISTEN}
      - UP_PROMETHEUS_NAMESPACE=${UP_PROMETHEUS_NAMESPACE}
      - UP_PROMETHEUS_DISABLE=${UP_PROMETHEUS_DISABLE}
      - UP_UNIFI_DEFAULT_SAVE_ALARMS=${UP_UNIFI_DEFAULT_SAVE_ALARMS}
      - UP_UNIFI_DEFAULT_SAVE_ANOMALIES=${UP_UNIFI_DEFAULT_SAVE_ANOMALIES}
      - UP_UNIFI_DEFAULT_SAVE_DPI=${UP_UNIFI_DEFAULT_SAVE_DPI}
      - UP_UNIFI_DEFAULT_SAVE_EVENTS=${UP_UNIFI_DEFAULT_SAVE_EVENTS}
      - UP_UNIFI_DEFAULT_SAVE_IDS=${UP_UNIFI_DEFAULT_SAVE_IDS}
      - UP_UNIFI_DEFAULT_SAVE_SITES=${UP_UNIFI_DEFAULT_SAVE_SITES}
      - UP_UNIFI_DEFAULT_URL=${UP_UNIFI_DEFAULT_URL}
      - UP_UNIFI_DEFAULT_USER=${UP_UNIFI_DEFAULT_USER}
    networks:
      - monitoring-network
  loki:
    image: grafana/loki:{{ loki_version }}
    container_name: loki
    restart: unless-stopped
    command: -config.file=/etc/loki/loki-config.yaml
    ports:
      - "{{ container_manager_host_ip }}:{{ loki_host_port }}:3100"
    volumes:
      - {{ loki_config_path }}:/etc/loki/loki-config.yaml:ro
      - loki_data:/loki
    networks:
      - monitoring-network
    healthcheck:
      test: ["CMD", "/usr/bin/loki", "-health"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
  blackbox:
    image: prom/blackbox-exporter:{{ blackbox_exporter_version }}
    container_name: blackbox
    restart: unless-stopped
    expose:
      - "9115"
    volumes:
      - {{ blackbox_exporter_config_path }}:/etc/blackbox_exporter/config.yml:ro
    networks:
      - monitoring-network
  alloy:
    image: grafana/alloy:{{ alloy_version }}
    container_name: alloy
    restart: unless-stopped
    command:
      - run
      - --server.http.listen-addr=0.0.0.0:12345
      - --storage.path=/var/lib/alloy/data
      - /etc/alloy/config.alloy
    ports:
      - "12345:12345"
      - "9514:9514/udp"
      - "5514:5514/udp" #older rfc3164 format handler
    volumes:
      - {{ alloy_config_dir }}/config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - alloy_data:/var/lib/alloy/data
    networks:
      - monitoring-network
    depends_on:
      loki:
        condition: service_healthy
volumes:
  grafana_storage:
    name: monitoring_stack_grafana_storage
  prometheus_data:
    name: monitoring_stack_prometheus_data
  loki_data:
    name: monitoring_stack_loki_data
  alloy_data:
    name: monitoring_stack_alloy_data
networks:
  monitoring-network:
    name: monitoring-network
    external: true